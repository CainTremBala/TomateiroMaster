# Copie este arquivo para .env.local e preencha com os dados do seu projeto.
# O .env.local não vai para o git (.gitignore).

# Firebase (Console do Firebase → Configurações do projeto → Seus apps → App da Web)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Backup na API (pasta backend/). No celular use o IP do computador na rede, ex:
# http://192.168.0.10:3000  (localhost só funciona no navegador do próprio computador)
EXPO_PUBLIC_API_URL=http://localhost:3000
