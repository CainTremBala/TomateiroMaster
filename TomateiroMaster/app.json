{
  "expo": {
    "name": "Tomateiro Master",
    "slug": "TomateiroMaster",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/ideias/icone002.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/ideias/splash001.png",
      "resizeMode": "cover",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/ideias/splash001.png",
          "resizeMode": "cover",
          "backgroundColor": "#D65A27"
        }
      ]
    ]
    
  }
}
